-- Translator tables, after every upstream migration. Idempotent: fork releases up to translator-v22 created
-- these tables in upstream's own migration numbers, and TranslatorLegacySchema rewinds such a database to
-- upstream version 15 after bringing its tables to this shape, so the upstream migrations still run.

CREATE TABLE IF NOT EXISTS translation_jobs (
    id TEXT NOT NULL PRIMARY KEY,
    manga_id INTEGER NOT NULL,
    chapter_id INTEGER NOT NULL,
    priority INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    payload TEXT NOT NULL
);

CREATE INDEX IF NOT EXISTS translation_jobs_chapter ON translation_jobs(chapter_id);

CREATE TABLE IF NOT EXISTS translation_images (
    job_id TEXT NOT NULL REFERENCES translation_jobs(id) ON DELETE CASCADE,
    image_id TEXT NOT NULL,
    image_index INTEGER NOT NULL,
    payload TEXT NOT NULL,
    PRIMARY KEY (job_id, image_id)
);

CREATE TABLE IF NOT EXISTS translation_results (
    job_id TEXT NOT NULL REFERENCES translation_jobs(id) ON DELETE CASCADE,
    image_id TEXT NOT NULL,
    committed_at INTEGER NOT NULL,
    payload TEXT NOT NULL,
    PRIMARY KEY (job_id, image_id)
);

CREATE TABLE IF NOT EXISTS translation_batches (
    id TEXT NOT NULL PRIMARY KEY,
    job_id TEXT NOT NULL REFERENCES translation_jobs(id) ON DELETE CASCADE,
    payload TEXT NOT NULL
);

CREATE TABLE IF NOT EXISTS translation_events (
    id TEXT NOT NULL PRIMARY KEY,
    job_id TEXT NOT NULL,
    time INTEGER NOT NULL,
    payload TEXT NOT NULL,
    operation_id TEXT,
    batch_id TEXT,
    image_id TEXT,
    stage TEXT NOT NULL DEFAULT 'legacy',
    level TEXT NOT NULL DEFAULT 'INFO'
);

CREATE INDEX IF NOT EXISTS translation_events_job_time ON translation_events(job_id, time);
CREATE INDEX IF NOT EXISTS translation_events_operation ON translation_events(operation_id, time DESC);
CREATE INDEX IF NOT EXISTS translation_events_batch ON translation_events(job_id, batch_id, time DESC);
CREATE INDEX IF NOT EXISTS translation_events_image ON translation_events(job_id, image_id, time DESC);

CREATE TABLE IF NOT EXISTS translation_reviews (
    id TEXT NOT NULL PRIMARY KEY,
    job_id TEXT NOT NULL REFERENCES translation_jobs(id) ON DELETE CASCADE,
    image_id TEXT NOT NULL,
    updated_at INTEGER NOT NULL,
    payload TEXT NOT NULL
);

CREATE INDEX IF NOT EXISTS translation_reviews_page ON translation_reviews(job_id, image_id);

CREATE TABLE IF NOT EXISTS translation_operations (
    id TEXT NOT NULL PRIMARY KEY,
    job_id TEXT NOT NULL,
    parent_id TEXT,
    batch_id TEXT,
    image_id TEXT,
    stage TEXT NOT NULL,
    state TEXT NOT NULL,
    updated_at INTEGER NOT NULL,
    payload TEXT NOT NULL
);
CREATE INDEX IF NOT EXISTS translation_operations_job ON translation_operations(job_id, updated_at DESC);
CREATE INDEX IF NOT EXISTS translation_operations_parent ON translation_operations(parent_id, updated_at);
CREATE INDEX IF NOT EXISTS translation_operations_image ON translation_operations(job_id, image_id);

CREATE TABLE IF NOT EXISTS translation_usage (
    id TEXT NOT NULL PRIMARY KEY,
    job_id TEXT NOT NULL,
    time INTEGER NOT NULL,
    provider TEXT NOT NULL,
    model TEXT NOT NULL,
    payload TEXT NOT NULL
);
CREATE INDEX IF NOT EXISTS translation_usage_time ON translation_usage(time DESC);
CREATE INDEX IF NOT EXISTS translation_usage_job ON translation_usage(job_id, time DESC);

CREATE TABLE IF NOT EXISTS translation_billing (
    id TEXT NOT NULL PRIMARY KEY,
    connection_id TEXT NOT NULL,
    period_start INTEGER NOT NULL,
    period_end INTEGER NOT NULL,
    synced_at INTEGER NOT NULL,
    payload TEXT NOT NULL
);
CREATE INDEX IF NOT EXISTS translation_billing_connection ON translation_billing(connection_id, period_start);
